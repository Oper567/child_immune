// --- CONFIGURATION ---

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Status {
  DUE
  COMPLETED
  MISSED
}

// --- MODELS ---

model HealthWorker {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  password    String
  clinicName  String   @default("Obiaruku Central Clinic")
  clinicCode  String
  
  // Relations
  registeredChildren Child[]
  administeredRecords Record[]
  
  createdAt   DateTime @default(now())
}

model Child {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  uhid            String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime @map("dob")
  guardianPhone   String
  
  // Relations
  records         Record[]
  registeredById  String?  @db.ObjectId
  registeredBy    HealthWorker? @relation(fields: [registeredById], references: [id])
  
  createdAt       DateTime @default(now())
}

model Record {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  vaccineName     String
  status          Status        @default(DUE)
  administeredAt  DateTime?
  nextDueDate     DateTime
  
  // Relations
  childId         String        @db.ObjectId
  child           Child         @relation(fields: [childId], references: [id])
  
  workerId        String?       @db.ObjectId
  worker          HealthWorker? @relation(fields: [workerId], references: [id])
  
  clinicName      String        @default("Obiaruku Central Clinic")
  updatedAt       DateTime      @updatedAt
}