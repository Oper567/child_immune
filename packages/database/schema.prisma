// packages/database/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ... Paste your Child, Record, and HealthWorker models below this
model Child {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  uhid            String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime @map("dob") // Mapped to match frontend state
  guardianPhone   String
  records         Record[]
  
  registeredById  String?  @db.ObjectId
  registeredBy    HealthWorker? @relation(fields: [registeredById], references: [id])
  
  createdAt       DateTime @default(now())
}

model Record {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  vaccineName     String
  status          Status        @default(DUE)
  administeredAt  DateTime?
  nextDueDate     DateTime
  
  childId         String        @db.ObjectId
  child           Child         @relation(fields: [childId], references: [id])
  
  // Link to Worker who performed the update
  workerId        String?       @db.ObjectId
  worker          HealthWorker? @relation(fields: [workerId], references: [id])
  
  clinicName      String        @default("Obiaruku Central Clinic")
}