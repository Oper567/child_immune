// 1. SETUP: Define the engine and provider
generator client {
  provider = "prisma-client-js"
}

// 2. DATABASE: Define your MongoDB connection
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// 3. ENUMS: Define your specific types
enum Status {
  COMPLETED
  DUE
  MISSED
}

enum Role {
  ADMIN
  NURSE
  DOCTOR
}

// 4. MODELS: Your application data structures
model HealthWorker {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String   @unique
  password          String
  role              Role     @default(NURSE)
  clinicName        String
  clinicCode        String
  
  recordsSigned     Record[] 
  childrenRegistered Child[] 
  
  createdAt         DateTime @default(now())
}

model Child {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  uhid            String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime @map("dob")
  guardianPhone   String
  records         Record[]
  
  registeredById  String?  @db.ObjectId
  registeredBy    HealthWorker? @relation(fields: [registeredById], references: [id])
  
  createdAt       DateTime @default(now())
}

model Record {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  vaccineName     String
  status          Status        @default(DUE)
  administeredAt  DateTime?
  nextDueDate     DateTime
  
  childId         String        @db.ObjectId
  child           Child         @relation(fields: [childId], references: [id])
  
  workerId        String?       @db.ObjectId
  worker          HealthWorker? @relation(fields: [workerId], references: [id])
  
  clinicName      String        @default("Obiaruku Central Clinic")
}